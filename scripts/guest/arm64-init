#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# /init of the arm64 mlink guest (P9, D21): busybox userland, mlink.ko as the
# modem peer of the x86 AP, and a control shell on the serial port (a unix
# socket on the host, see scripts/host/vm-arm64.sh).
/bin/busybox --install -s /bin
export PATH=/bin
# DEVTMPFS_MOUNT only covers a real root fs, not the initramfs
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t debugfs debugfs /sys/kernel/debug
mount -t tmpfs tmpfs /tmp
ip link set lo up

echo "arm64-init: $(uname -r), $(nproc) CPUs"
if [ -z "$(sed -n 's/.*mlink_noload.*/x/p' /proc/cmdline)" ]; then
	insmod /lib/modules/$(uname -r)/mlink.ko role=modem &&
		ip addr add 10.77.0.2 peer 10.77.0.1 dev mlink0 &&
		ip link set mlink0 up &&
		echo "arm64-init: mlink0 up 10.77.0.2 -> 10.77.0.1"
fi

# Control shell on the serial port, restarted if it exits. stdin is a pipe,
# so sh is non-interactive (no prompt, no line-editor echo); tty echo is off.
# The host side (scripts/host/arm64-bridge.py) then reads command output only.
(while true; do
	(stty -echo; exec cat) </dev/ttyAMA0 | sh >/dev/ttyAMA0 2>&1	# stty on the fd cat reads
	sleep 0.2
done) &

# PID 1 must never exit (the serial console is a log file, so no shell on it).
while true; do sleep 3600; done
