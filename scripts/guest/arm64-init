#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# /init of the arm64 mlink guest (P9, D21): busybox userland, mlink.ko as the
# modem peer of the x86 AP, a control shell on tcp/23 (reachable only via the
# host's 127.0.0.1:2223 user-net forward), and the serial console.
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t debugfs debugfs /sys/kernel/debug
mount -t tmpfs tmpfs /tmp

# control NIC (QEMU user-net defaults)
ip link set lo up
ip link set eth0 up
ip addr add 10.0.2.15/24 dev eth0

echo "arm64-init: $(uname -r), $(nproc) CPUs"
if [ -z "$(sed -n 's/.*mlink_noload.*/x/p' /proc/cmdline)" ]; then
	insmod /lib/modules/$(uname -r)/mlink.ko role=modem &&
		ip addr add 10.77.0.2 peer 10.77.0.1 dev mlink0 &&
		ip link set mlink0 up &&
		echo "arm64-init: mlink0 up 10.77.0.2 -> 10.77.0.1"
fi

# Control shell: one connection at a time, re-armed after each.
(while true; do nc -l -p 23 -e /bin/sh; done) &

# PID 1 must never exit (the serial console is a log file, so no shell on it).
while true; do sleep 3600; done
