C mlink-kick-no-consumer-mb

(*
 * Result: Sometimes
 *
 * BROKEN variant of mlink-kick (unsafe_no_mb on the consumer): without the
 * full barrier, the consumer's re-read of prod can be satisfied before its
 * want_kick store is visible to the producer.
 *)

{}

P0(int *prod, int *want_kick)
{
	int r0;

	smp_store_release(prod, 1);
	smp_mb();
	r0 = READ_ONCE(*want_kick);
}

P1(int *prod, int *want_kick)
{
	int r1;

	WRITE_ONCE(*want_kick, 1);
	r1 = READ_ONCE(*prod);
}

exists (0:r0=0 /\ 1:r1=0)
