# mlink KCSAN kernel (optional, P5.4): base + data-race detector.
# KCSAN and KASAN are mutually exclusive, hence a separate build. KCSAN only sees
# races inside one kernel; cross-VM ordering is covered by the LKMM litmus tests.

CONFIG_LOCALVERSION="-mlink-kcsan"
CONFIG_KCSAN=y
CONFIG_KCSAN_STRICT=y
