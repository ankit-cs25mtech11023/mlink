# mlink debug kernel: base + sanitizers and lock checking.
# Numbers measured on this kernel are labeled "debug" and never used as headlines.

CONFIG_LOCALVERSION="-mlink-debug"

# Memory errors
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
CONFIG_SLUB_DEBUG=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_LIST=y

# Locking / context
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y

# Hangs
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# Keep running after an oops so the serial log captures everything; panic=1
# on the cmdline still reboots (and -no-reboot then exits QEMU) on a real panic.
# CONFIG_PANIC_ON_OOPS is not set
