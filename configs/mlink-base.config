# mlink guest kernel: applied on top of x86_64_defconfig + kvm_guest.config.
# No initramfs, so everything needed to mount root and reach ssh is built in (=y).

CONFIG_LOCALVERSION="-mlink"
# CONFIG_LOCALVERSION_AUTO is not set
# gcc 15 may warn in code we do not touch; the module has its own -Werror.
# CONFIG_WERROR is not set

# Modules (out-of-tree mlink.ko), unsigned
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
# CONFIG_MODULE_SIG is not set

# PCI / MSI-X for ivshmem-doorbell
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# Root disk, management NIC, 9p share
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# Networking
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y

# Observability
CONFIG_DEBUG_FS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_IKHEADERS=y
CONFIG_UNWINDER_ORC=y
CONFIG_GDB_SCRIPTS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_MAGIC_SYSRQ=y

# Trim what a headless KVM guest never uses (build time on the old laptop)
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_REISERFS_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_DRM_VIRTIO_GPU is not set
# CONFIG_AGP is not set
# CONFIG_FB is not set
# CONFIG_HAMRADIO is not set
# CONFIG_BT is not set
# CONFIG_NFC is not set
